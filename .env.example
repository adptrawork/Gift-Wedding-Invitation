# Supabase (cloud — dipakai lokal via DDEV dan prod)
# Format key BARU: sb_publishable_... (fallback lama: NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Service role HANYA di server (webhook). Jangan pernah expose ke client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (SERVER ONLY)

# Base domain untuk slug/subdomain routing
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
# Prod contoh: NEXT_PUBLIC_BASE_DOMAIN=namaplatform.com

# URL publik ROOT (tanpa path). Dipakai untuk membangun callback Duitku dan
# redirect balik ke dashboard. WAJIB bisa dijangkau internet — callback Duitku
# ditolak kalau hanya bisa dijangkau dari localhost/LAN.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Contoh lokal dengan tunnel: https://abc-def.gh.trycloudflare.com

# ===== Payment — Duitku =====
# Merchant Code + API Key ada di dashboard Duitku > Settings > Project.
DUITKU_MERCHANT_CODE=DXXXXXXX
DUITKU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# true = produksi (passport.duitku.com). Kosong/false = sandbox.duitku.com
DUITKU_IS_PRODUCTION=
# Fallback kode channel (2 karakter) kalau permintaan tidak menyertakan
# payment_method. Daftar lengkap channel aktif ada di /api/payments/channels.
# Catatan: project Duitku umumnya TIDAK mengaktifkan "*" (pilihan semua channel
# di halaman bayar) — jadi form billing menampilkan pilihan channel dan user
# memilih sendiri. Contoh kode: BC (BCA VA), BR (BRI VA), M2 (Mandiri VA),
# SP (ShopeePay QRIS), DA (DANA), FT (ritel).
DUITKU_PAYMENT_METHOD=BC
# Masa berlaku invoice, menit. Maks 1440 (VA/ritel/e-wallet).
DUITKU_EXPIRY_MINUTES=1440

# Sentry (opsional, US-020)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Migrasi database (opsional, hanya untuk scripts/db-migrate.sh) ---
# Host db.<ref>.supabase.co hanya punya alamat IPv6. Kalau jaringan lokal tidak
# punya route IPv6 global, script otomatis fallback ke Supavisor (IPv4).
SUPABASE_DB_REGION=ap-south-1
# Password ini untuk DDL lewat psql, bukan untuk aplikasi Next.js.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
