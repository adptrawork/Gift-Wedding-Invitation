# Supabase (cloud — dipakai lokal via DDEV dan prod)
# Format key BARU: sb_publishable_... (fallback lama: NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Service role HANYA di server (webhook). Jangan pernah expose ke client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (SERVER ONLY)

# Base domain untuk slug/subdomain routing
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
# Prod contoh: NEXT_PUBLIC_BASE_DOMAIN=namaplatform.com

# Payment — pilih salah satu dulu (Midtrans disarankan untuk MVP ID)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxx
# Xendit (opsional phase 2 MVP)
XENDIT_SECRET_KEY=xnd_development_xxx
XENDIT_WEBHOOK_TOKEN=xxx

# Sentry (opsional, US-020)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
